+def trim_trajectory_memory(kv_cache, global_idx: int, max_context_frames: int) -> None:
+    """Bound the dict-cache trajectory memory to the most recent N frames.
+
+    ``k_{i}_special`` / ``v_{i}_special`` hold the special tokens (camera +
+    registers + scale) of every frame that has already fallen out of the local
+    sliding window.  Left alone they grow for the whole sequence, which is the
+    one part of the streaming state that is *not* O(1) — it is what makes
+    open-ended runs die on VRAM.
+
+    Keeping only the newest ``max_context_frames`` entries turns the whole cache
+    into a fixed-size working set: anchor frames (kept in full in ``k_{i}``)
+    + this bounded memory + the local window.  The anchor is stored separately,
+    so a plain FIFO trim here does not disturb it.
+
+    ``max_context_frames <= 0`` disables the trim (original behavior).
+    """
+    if max_context_frames <= 0:
+        return
+    key_k = f"k_{global_idx}_special"
+    if kv_cache.get(key_k) is None:
+        return
+    if kv_cache[key_k].shape[2] <= max_context_frames:
+        return
+    key_v = f"v_{global_idx}_special"
+    # dim 2 is the frame axis: [B, H, frames, num_special, D]
+    kv_cache[key_k] = kv_cache[key_k][:, :, -max_context_frames:, :, :].contiguous()
+    kv_cache[key_v] = kv_cache[key_v][:, :, -max_context_frames:, :, :].contiguous()
+
